{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "useDefineForClassFields": true,
    // `node` is here for the e2e harness alone: it shells out to `supabase status` and resolves
    // paths, which is Node's surface, not the browser's. The app under src/ never sees it —
    // nothing there can import node:* without the bundler failing anyway.
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "e2e", "scripts", "vite.config.ts", "vitest.config.ts", "eslint.config.ts", "playwright.config.ts"]
}
