# Frontend (Vite) env — copy to .env.local for local dev.

VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_KEY=your-supabase-anon-key

# Billing backend (Hono server, see server/). In production set to its deployed URL.
VITE_API_URL=http://localhost:8787

# Advertising pixels on the MARKETING PAGES ONLY (never on a shop's storefront). Unset here on
# purpose: with neither set, no third-party script is ever requested and the consent banner never
# renders, which is the state dev, CI and the e2e run need. Set them in Vercel, not here.
#
# WARNING: setting VITE_TIKTOK_PIXEL_ID requires naming TikTok in src/legal/documents.ts FIRST.
# The privacy notice names Meta only today, because TikTok currently receives nothing — and a
# notice that names a recipient of personal data which receives none is a false statement in a
# legal document. The env var is the switch; the notice is the precondition. legal.test.ts holds
# that line and will fail if TikTok appears in the notice before it receives anything.
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
